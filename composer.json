{
    "name": "swage/security-scanner",
    "description": "Reads each server's SSH, sudo and nginx logs for brute force attempts and probing, raises alerts and blocks addresses for Swage.",
    "type": "swage-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Swage\\SecurityScanner\\": "src/"
        }
    },
    "extra": {
        "swage": {
            "kind": "server-integration",
            "contract": 1
        },
        "laravel": {
            "providers": [
                "Swage\\SecurityScanner\\SecurityScannerServiceProvider"
            ]
        }
    }
}
